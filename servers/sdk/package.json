{
  "name": "@idosgames/mcp",
  "version": "0.1.40",
  "packageManager": "npm@11.17.0",
  "mcpName": "com.idosgames/sdk",
  "description": "MCP server that serves the iDosGames Module & Skills Registry to AI coding agents (Claude Code, Codex, Cursor…): list/pull composable game modules and the host scaffold, and load skills for @idosgames/core, the module contract, and composition.",
  "type": "module",
  "license": "MIT",
  "author": "iDos Games",
  "homepage": "https://github.com/iDos-Games/idosgames-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iDos-Games/idosgames-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/iDos-Games/idosgames-mcp/issues"
  },
  "keywords": [
    "idosgames",
    "mcp",
    "model-context-protocol",
    "ai",
    "gamedev",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "idosgames-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "registry",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@idosgames/timeline": "^0.1.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  }
}
